[gd_resource type="Resource" script_class="ChipProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/types/chip_profile.gd" id="1"]

[resource]
script = ExtResource("1")
id = "pc"
display_name = "DOS PC"
chip_name = "PC speaker to Gravis Ultrasound"
description = "The sound of DOS games: the PC speaker, the Tandy 1000's SN76496, the AdLib and Sound Blaster's OPL2 FM chip, the Sound Blaster Pro's two OPL2s, the Sound Blaster 16's OPL3, the Roland MT-32 and Sound Canvas MIDI modules, and the Gravis Ultrasound. Exports C data for the speaker, VGM, IMF, DRO, MIDI and Impulse Tracker music, and VOC, WAV or FM sound effects."
phase = 7
available = true
stereo = true
echo = false
max_voices = 18
voices = Array[Dictionary]([{
"name": "FM 1-9",
"waves": ["fm"]
},{
"name": "Rhythm",
"waves": ["bd", "sd", "tom", "cym", "hh"]
}])
export_formats = PackedStringArray("c", "bin", "wlf", "dro", "vgm", "mid", "it", "voc", "wav")
