[gd_resource type="Resource" script_class="ChipProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/types/chip_profile.gd" id="1"]

[resource]
script = ExtResource("1")
id = "pce"
display_name = "PC Engine / TurboGrafx-16"
chip_name = "HuC6280"
description = "6 wavetable voices (32 x 5-bit), 2 with noise. Exports data and a small MIT C player for HuCC, with a ROM project."
phase = 4
available = true
stereo = true
echo = false
max_voices = 6
voices = Array[Dictionary]([{
"name": "Channel 1",
"waves": ["wavetable"]
},{
"name": "Channel 2",
"waves": ["wavetable"]
},{
"name": "Channel 3",
"waves": ["wavetable"]
},{
"name": "Channel 4",
"waves": ["wavetable"]
},{
"name": "Channel 5",
"waves": ["wavetable", "noise"]
},{
"name": "Channel 6",
"waves": ["wavetable", "noise"]
}])
export_formats = PackedStringArray("c", "bin", "wav")
