[gd_resource type="Resource" script_class="SfxPreset" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/types/sfx_preset.gd" id="1"]

[resource]
script = ExtResource("1")
id = "round_start"
display_name = "Round Start"
group = "Game flow"
description = "Round Start: plain beep"
base = {
"wave": "square",
"sustain": 0.3,
"decay": 0.1,
"base_freq": 0.5,
"duty": 0.5,
"repeat_speed": 0.5
}
ranges = {
"base_freq": [-0.05, 0.05]
}
waves = PackedStringArray("square", "sine", "triangle")
variants = Array[Dictionary]([{
"name": "Pure",
"base": {
"wave": "sine"
},
"waves": ["sine", "triangle"]
}, {
"name": "Thin",
"base": {
"wave": "square",
"duty": 0.7,
"hpf_freq": 0.15
},
"waves": ["square"]
}, {
"name": "Blip up",
"base": {
"arp_mod": 0.35,
"arp_speed": 0.8
}
}, {
"name": "Echo",
"base": {
"echo": 0.3,
"echo_delay": 0.1
}
}])
