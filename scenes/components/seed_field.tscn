[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/components/seed_field.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_dice.svg" id="2"]

[node name="SeedField" type="HBoxContainer"]
script = ExtResource("1")

[node name="Label" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "SEED"

[node name="Edit" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Same settings and same seed always give the same song. Words work too."
placeholder_text = "Number or word"
select_all_on_focus = true

[node name="Dice" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
tooltip_text = "New seed"
icon = ExtResource("2")
icon_alignment = 1
