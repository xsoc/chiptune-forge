[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/components/catalog_picker.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_search.svg" id="2"]

[node name="CatalogPicker" type="VBoxContainer"]
script = ExtResource("1")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionLabel"
text = "VIBE"
uppercase = true

[node name="Hint" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Blend up to 3"

[node name="Search" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Search"
clear_button_enabled = true
right_icon = ExtResource("2")

[node name="Tabs" type="TabBar" parent="."]
unique_name_in_owner = true
layout_mode = 2
clip_tabs = true
scrolling_enabled = true
max_tab_width = 200

[node name="ChipScroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Chips" type="HFlowContainer" parent="ChipScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Strengths" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 2

[node name="EmptyHint" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"WarningLabel"
autowrap_mode = 3

[node name="ConfirmRemove" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Remove?"
ok_button_text = "Remove"
dialog_autowrap = true

[connection signal="confirmed" from="ConfirmRemove" to="." method="_on_remove_confirmed"]
