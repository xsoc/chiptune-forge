[node name="SfxScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Columns" type="Container" parent="Scroll/Margin"]
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2")
min_column_width = 320
column_weights = {
3: [1.2, 1.0, 1.0]
}

[node name="PresetsCard" type="PanelContainer" parent="Scroll/Margin/Columns"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="PresetPicker" parent="Scroll/Margin/Columns/PresetsCard" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2
title = "Preset"
hint = "Tap to hear a new take"
chip_variation = &"SfxChip"
chips_min_height = 300

[node name="SoundCard" type="PanelContainer" parent="Scroll/Margin/Columns"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="Sound" type="VBoxContainer" parent="Scroll/Margin/Columns/SoundCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Name" type="Label" parent="Scroll/Margin/Columns/SoundCard/Sound"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BigTitleLabel"
text = "Coin"

[node name="Note" type="Label" parent="Scroll/Margin/Columns/SoundCard/Sound"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Modern chiptune: plays on any voice, no limits."
autowrap_mode = 3

[node name="Waveform" type="Control" parent="Scroll/Margin/Columns/SoundCard/Sound"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
script = ExtResource("4")

[node name="Play" type="Button" parent="Scroll/Margin/Columns/SoundCard/Sound"]
