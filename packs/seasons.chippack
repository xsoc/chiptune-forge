{
	"format": "chiptune-forge-pack",
	"version": 1,
	"name": "Seasons",
	"author": "Chiptune Forge",
	"license": "CC0-1.0",
	"description": "An example pack: four seasonal vibes, a harvest-dance style and two weather sounds.",
	"url": "https://github.com/xsoc/chiptune-forge/tree/main/packs",
	"vibes": [
		{
			"id": "spring_morning",
			"display_name": "Spring morning",
			"group": "Places",
			"description": "Spring morning: fresh, bright and rising, 100 to 130 BPM",
			"mode_weights": {"major": 3.0, "lydian": 1.5, "major_pentatonic": 1.0},
			"progression_weights": {"pop": 1.5, "folk": 1.5},
			"chord_colour": 0.25,
			"tempo_min": 100,
			"tempo_max": 130,
			"energy": 0.5,
			"brightness": 0.85,
			"tension": 0.05,
			"contour": 0.6,
			"legato": 0.5,
			"echo": 0.25
		},
		{
			"id": "summer_heat",
			"display_name": "Summer heat",
			"group": "Places",
			"description": "Summer heat: lazy, warm and swung, 85 to 110 BPM",
			"mode_weights": {"mixolydian": 2.0, "major": 1.5, "dorian": 1.0},
			"progression_weights": {"pop": 1.0, "jazz": 0.5},
			"chord_colour": 0.45,
			"bars_per_chord": 2.0,
			"tempo_min": 85,
			"tempo_max": 110,
			"energy": 0.35,
			"brightness": 0.7,
			"tension": 0.1,
			"legato": 0.7,
			"swing": 0.3,
			"echo": 0.35
		},
		{
			"id": "autumn_leaves",
			"display_name": "Autumn leaves",
			"group": "Sad and reflective",
			"description": "Autumn leaves: gentle, falling and wistful, 75 to 100 BPM",
			"mode_weights": {"dorian": 2.0, "minor": 1.5, "major": 0.5},
			"progression_weights": {"folk": 1.5, "classical": 1.0},
			"chord_colour": 0.35,
			"bars_per_chord": 2.0,
			"tempo_min": 75,
			"tempo_max": 100,
			"energy": 0.3,
			"brightness": 0.4,
			"tension": 0.15,
			"contour": -0.5,
			"legato": 0.75,
			"echo": 0.3
		},
		{
			"id": "winter_frost",
			"display_name": "Winter frost",
			"group": "Calm and warm",
			"description": "Winter frost: still, glassy and slow, 60 to 85 BPM",
			"mode_weights": {"lydian": 2.0, "major": 1.0, "whole_tone": 0.5},
			"progression_weights": {"dreamy": 2.0, "classical": 0.5},
			"chord_colour": 0.4,
			"bars_per_chord": 2.0,
			"tempo_min": 60,
			"tempo_max": 85,
			"energy": 0.15,
			"brightness": 0.75,
			"tension": 0.1,
			"weirdness": 0.1,
			"legato": 0.85,
			"echo": 0.5
		}
	],
	"styles": [
		{
			"id": "harvest_dance",
			"display_name": "Harvest dance",
			"group": "World and folk",
			"description": "Harvest dance: a stomping polka with oom-pah bass, 120 to 150 BPM",
			"tempo_min": 120,
			"tempo_max": 150,
			"beats_per_bar": 2,
			"drum_pattern": "polka",
			"drum_density": 0.55,
			"bass_patterns": {"root_fifth": 3.0, "octave": 1.0},
			"accompaniment": {"chord_arp": 1.0, "broken": 0.5},
			"harmony_parts": {"thirds": 2.0, "counter": 0.5},
			"melody_density": 0.65,
			"syncopation": 0.1,
			"progression_weights": {"folk": 2.0, "pop": 0.5},
			"lead_wave": "pulse",
			"bass_wave": "triangle",
			"forms": {"verse_chorus": 1.0, "rondo": 1.0}
		}
	],
	"sfx_presets": [
		{
			"id": "raindrop",
			"display_name": "Raindrop",
			"group": "World",
			"description": "Raindrop: a short falling plink",
			"base": {"wave": "sine", "sustain": 0.02, "punch": 0.3, "decay": 0.15, "base_freq": 0.6, "freq_ramp": -0.3},
			"ranges": {"base_freq": [-0.1, 0.1], "decay": [-0.05, 0.05]},
			"waves": ["sine", "triangle"]
		},
		{
			"id": "gust_of_wind",
			"display_name": "Gust of wind",
			"group": "World",
			"description": "Gust of wind: soft noise that swells and fades",
			"base": {"wave": "noise", "attack": 0.4, "sustain": 0.3, "decay": 0.5, "base_freq": 0.25, "freq_ramp": 0.05},
			"ranges": {"base_freq": [-0.05, 0.05], "attack": [-0.1, 0.1], "decay": [-0.1, 0.1]},
			"waves": ["noise"]
		}
	]
}
